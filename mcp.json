{
  "name": "singlecraft-mcp",
  "version": "1.0.0",
  "tools": [
    {
      "name": "start_server",
      "description": "Start a Minecraft server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server_id": {
            "type": "integer",
            "description": "Server ID to start"
          }
        },
        "required": ["server_id"]
      }
    },
    {
      "name": "stop_server",
      "description": "Stop a Minecraft server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server_id": {
            "type": "integer",
            "description": "Server ID to stop"
          }
        },
        "required": ["server_id"]
      }
    }
  ]
}